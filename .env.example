# Copy to .env at this repository root (one file for backend + Alexa local).

# --- Go API (make run runs with cwd backend/) ---
PORT=8080
GIN_MODE=debug
DATABASE_URL=postgres://kitzz:kitzz_dev_pass@localhost:5433/kitzz?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Firebase Admin JSON (same project as Flutter google-services.json).
# Path is relative to backend/ when using make run — file usually lives at repo root:
FIREBASE_CREDENTIALS_FILE=../your-project-firebase-adminsdk-xxxxx.json

# OAuth2 (Alexa Account Linking)
OAUTH_AUTH_CODE_TTL=600

# Go reverse-proxy to the Node skill (one ngrok tunnel)
ALEXA_SKILL_URL=http://localhost:3000

# --- Alexa local skill (alexa-skill/local/server.js loads this same .env) ---
# Same public host as Flutter dart-define API_BASE_URL (no trailing slash).
BACKEND_URL=http://127.0.0.1:8080
SKILL_PORT=3000

# Verbose JWT / Authorization logs (prefix + lengths only; never full token)
# AUTH_DEBUG=1

# Include body_len on [alexa-in] lines (Amazon -> POST /alexa)
# ALEXA_REQUEST_DEBUG=1
