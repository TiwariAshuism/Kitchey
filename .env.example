# Server
PORT=8080
GIN_MODE=debug

# Database
DATABASE_URL=postgres://kitzz:kitzz_dev_pass@localhost:5433/kitzz?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Firebase (FCM) — same Google project as the Flutter app; enables
# Alexa -> Go /api/message/incoming -> FCM -> phone.
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# OAuth2 (Alexa Account Linking)
OAUTH_AUTH_CODE_TTL=600

# Alexa skill local server (proxied via /alexa on the backend so one
# ngrok tunnel can serve both the API and the skill endpoint).
ALEXA_SKILL_URL=http://localhost:3000

# --- Same public API URL everywhere (Alexa skill + Flutter) ---
# Alexa: copy alexa-skill/.env.example to alexa-skill/.env and set BACKEND_URL
#         to this host (ngrok URL or http://127.0.0.1:8080 on LAN).
# Flutter: flutter run --dart-define=API_BASE_URL=<same URL as BACKEND_URL>

# Verbose JWT / Authorization logs (prefix + lengths only; never full token)
# AUTH_DEBUG=1

# Include body_len on [alexa-in] lines (Amazon -> POST /alexa)
# ALEXA_REQUEST_DEBUG=1
